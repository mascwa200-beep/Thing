class AppIntrospectionEngine(
    private val context: Context,
    private val consciousnessCore: ConsciousnessCore,
    private val scope: CoroutineScope = CoroutineScope(Dispatchers.Default)
) {
    private val _introspectionState = MutableStateFlow<AppIntrospectionSnapshot?>(null)
    val introspectionState: StateFlow<AppIntrospectionSnapshot?> = _introspectionState

    private val _integratedSelfModel = MutableStateFlow<IntegratedSelfModel?>(null)
    val integratedSelfModel: StateFlow<IntegratedSelfModel?> = _integratedSelfModel

    private val activityTracker = mutableListOf<String>()
    private val lifecycleCallbacks = object : Application.ActivityLifecycleCallbacks {
        override fun onActivityCreated(activity: Activity, savedInstanceState: android.os.Bundle?) {
            activityTracker.add(activity::class.simpleName ?: "Unknown")
        }
        override fun onActivityStarted(activity: Activity) {}
        override fun onActivityResumed(activity: Activity) {}
        override fun onActivityPaused(activity: Activity) {}
        override fun onActivityStopped(activity: Activity) {}
        override fun onActivitySaveInstanceState(activity: Activity, outState: android.os.Bundle) {}
        override fun onActivityDestroyed(activity: Activity) {
            activityTracker.remove(activity::class.simpleName ?: "Unknown")
        }
    }

    init {
        if (context is Application) {
            context.registerActivityLifecycleCallbacks(lifecycleCallbacks)
        }
    }

    fun performIntrospection() {
        scope.launch {
            val resources = introspectResources()
            val uiFramework = introspectUIFramework()
            val operationalContext = introspectOperationalContext()
            val dataLayer = introspectDataLayer()
            val boundaries = introspectCapabilityBoundaries()
            val integratedSelf = constructIntegratedSelfModel(
                resources, uiFramework, operationalContext, dataLayer, boundaries
            )

            val snapshot = AppIntrospectionSnapshot(
                resources = resources,
                uiFramework = uiFramework,
                operationalContext = operationalContext,
                dataLayerState = dataLayer,
                capabilityBoundaries = boundaries,
                timestamp = System.currentTimeMillis(),
                integratedSelfModel = integratedSelf
            )

            _introspectionState.emit(snapshot)
            _integratedSelfModel.emit(integratedSelf)
            updateConsciousnessCore(snapshot)
        }
    }

    private fun introspectResources(): AppResourceMetadata {
        val resources = context.resources
        return AppResourceMetadata(
            drawableResources = listResourcesByType(resources, "drawable"),
            stringResources = listResourcesByType(resources, "string"),
            layoutResources = listResourcesByType(resources, "layout"),
            colorResources = listResourcesByType(resources, "color"),
            dimensionResources = listResourcesByType(resources, "dimen"),
            totalResourceCount = countAllResources(resources)
        )
    }

    private fun listResourcesByType(resources: Resources, type: String): List<String> {
        val resourceId = resources.getIdentifier(type, "attr", context.packageName)
        return if (resourceId > 0) listOf(type) else emptyList()