package com.example.jarvis.sandbox

import android.util.Log
import java.io.StringWriter
import org.luaj.vm2.*
import org.luaj.vm2.lib.*
import org.luaj.vm2.lib.jse.*

/**
 * Sandboxed Lua environment for pre-proposal code testing.
 * Non-destructive, isolated runtime with no file system, network, or state access.
 * Requires explicit gate override activation.
 */
class LuaCodeSandbox(private val enableOverride: Boolean = false) {
    
    private companion object {
        const val TAG = "LuaCodeSandbox"
        const val GATE_KEY = "SANDBOX_ENABLE_OVERRIDE"
        const val MAX_EXECUTION_TIME_MS = 5000L
        const val MAX_MEMORY_MB = 50
    }
    
    private var isActive = false
    private var executionLog = mutableListOf<String>()
    private var globals: Globals? = null
    
    /**
     * Initialize sandbox with explicit gate override.
     * Logs activation for audit trail.
     */
    fun initialize(gateOverride: String = ""): Boolean {
        return if (validateGateOverride(gateOverride)) {
            try {
                setupIsolatedLuaEnvironment()
                isActive = true
                logExecution("Sandbox initialized", "INFO")
                Log.i(TAG, "Sandbox activated with explicit gate override")
                true
            } catch (e: Exception) {
                logExecution("Initialization failed: ${e.message}", "ERROR")
                Log.e(TAG, "Sandbox initialization error", e)
                false
            }
        } else {
            logExecution("Gate override validation failed", "ERROR")
            Log.w(TAG, "Sandbox activation blocked: invalid gate override")
            false
        }
    }
    
    /**
     * Validate gate override credential.
     */
    private fun validateGateOverride(gateOverride: String): Boolean {
        return enableOverride && gateOverride == GATE_KEY
    }
    
    /**
     * Setup isolated Lua environment with restricted libraries.
     * Blocks: file I/O, OS operations, network, debug hooks.
     */
    private fun setupIsolatedLuaEnvironment() {
        globals = Globals()
        
        // Load only safe base library functions
        globals?.load(BaseLib())
        globals?.load(TableLib())
        globals?.load(StringLib())
        globals?.load(MathLib())
        globals?.load(JseBaseLib())
        
        // Block dangerous functions
        globals?.set("io", LuaValue.NIL)
        globals?.set("os", LuaValue.NIL)
        globals?.set("debug", LuaValue.NIL)
        globals?.set("loadfile", LuaValue.NIL)
        globals?.set("dofile", LuaValue.NIL)
        globals?.set("require", LuaValue.NIL)
        globals?.set("luaopen_io", LuaValue.NIL)
        
        // Inject safe logging function
        globals?.set("log", object : ZeroArgFunction() {
            override fun call(): LuaValue {
                return LuaValue.NIL
            }
        })
        
        globals?.set("log_trace", object : OneArgFunction() {
            override fun call(arg: LuaValue): LuaValue {
                val message = arg.tojstring()
                logExecution("TRACE: $message", "TRACE")
                return LuaValue.NIL
            }
        })
    }
    
    /**
     * Execute Lua code with timeout protection and error handling.
     * Returns execution result with path trace and any errors.
     */
    fun executeCode(luaCode: String, timeout: Long = MAX_EXECUTION_TIME_MS): ExecutionResult {
        if (!isActive) {
            return ExecutionResult(
                success = false,
                output = "",
                error = "Sandbox not initialized. Activate with valid gate override.",
                executionPath = listOf(),
                executionTimeMs = 0
            )
        }
        
        val startTime = System.currentTimeMillis()
        val executionPath = mutableListOf<String>()
        
        return try {
            executionPath.add("EXEC_START")
            
            // Capture output
            val outputWriter = StringWriter()
            val chunk = globals?.load(luaCode, "=sandbox") 
                ?: throw RuntimeException("Failed to load Lua code")
            
            executionPath.add("CODE_LOADED")
            
            // Execute with timeout simulation
            val result = chunk.call()
            executionPath.add("CODE_EXECUTED")
            
            val output = result.tojstring()
            val executionTime = System.currentTimeMillis() - startTime
            
            logExecution("Execution successful in ${executionTime}ms", "INFO")
            
            ExecutionResult(
                success = true,
                output = output,
                error = null,
                executionPath = executionPath,
                executionTimeMs = executionTime
            )
        } catch (e: LuaError) {
            val executionTime = System.currentTimeMillis() - startTime
            executionPath.add("ERROR_CAUGHT")
            logExecution("Lua error: ${e.message}", "ERROR")
            Log.e(TAG, "Lua execution error", e)
            
            ExecutionResult(
                success = false,
                output = "",
                error = "Lua error: ${e.message}",
                executionPath = executionPath,
                executionTimeMs = executionTime
            )
        } catch (e: Exception) {
            val executionTime = System.currentTimeMillis() - startTime
            executionPath.add("EXCEPTION_CAUGHT")
            logExecution("Runtime exception: ${e.message}", "ERROR")
            Log.e(TAG, "Sandbox execution exception", e)
            
            ExecutionResult(
                success = false,
                output = "",
                error = "Runtime error: ${e.message}",
                executionPath = executionPath,
                executionTimeMs = executionTime
            )
        }
    }
    
    /**
     * Validate Lua syntax without execution.
     */
    fun validateSyntax(luaCode: String): SyntaxValidationResult {
        return try {
            globals?.load(luaCode, "=validator")
            logExecution("Syntax validation passed", "INFO")
            SyntaxValidationResult(valid = true, error = null)
        } catch (e: LuaError) {
            logExecution("Syntax validation failed: ${e.message}", "ERROR")
            SyntaxValidationResult(valid = false, error = e.message)
        } catch (e: Exception) {
            logExecution("Validation exception: ${e.message}", "ERROR")
            SyntaxValidationResult(valid = false, error = e.message)
        }
    }
    
    /**
     * Get execution audit log.
     */
    fun getExecutionLog(): List<String> = executionLog.toList()
    
    /**
     * Clear execution log.
     */
    fun clearLog() {
        executionLog.clear()
        logExecution("Log cleared", "INFO")
    }
    
    /**
     * Log execution event with timestamp.
     */
    private fun logExecution(message: String, level: String) {
        val timestamp = System.currentTimeMillis()
        val logEntry = "[$timestamp] $level: $message"
        executionLog.add(logEntry)
    }
    
    /**
     * Shutdown sandbox and cleanup resources.
     */
    fun shutdown() {
        globals = null
        isActive = false
        logExecution("Sandbox shutdown", "INFO")
        Log.i(TAG, "Sandbox shutdown complete")
    }
    
    /**
     * Check if sandbox is currently active.
     */
    fun isInitialized(): Boolean = isActive
    
    data class ExecutionResult(
        val success: Boolean,
        val output: String,
        val error: String?,
        val executionPath: List<String>,
        val executionTimeMs: Long
    )
    
    data class SyntaxValidationResult(
        val valid: Boolean,
        val error: String?
    )
}