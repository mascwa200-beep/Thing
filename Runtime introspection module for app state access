package com.jarvis.introspection

import android.app.ActivityManager
import android.content.Context
import android.os.Debug
import android.os.Handler
import android.os.Looper
import android.os.Process
import android.util.Log
import androidx.lifecycle.Lifecycle
import androidx.lifecycle.LifecycleObserver
import androidx.lifecycle.OnLifecycleEvent
import java.io.File
import java.lang.ref.WeakReference
import java.text.SimpleDateFormat
import java.util.*
import java.util.concurrent.CopyOnWriteArrayList
import java.util.concurrent.locks.ReentrantReadWriteLock
import kotlin.concurrent.read
import kotlin.concurrent.write

data class ScreenState(
    val activeScreen: String,
    val isVisible: Boolean,
    val lifecycle: String,
    val timestamp: Long
)

data class ResourceInfo(
    val name: String,
    val type: String,
    val size: Long,
    val loaded: Boolean,
    val timestamp: Long
)

data class UIHierarchyNode(
    val className: String,
    val id: String,
    val visible: Boolean,
    val bounds: String,
    val children: List<UIHierarchyNode>
)

data class MemoryMetrics(
    val nativeHeap: Long,
    val javaHeap: Long,
    val totalMemory: Long,
    val freeMemory: Long,
    val maxMemory: Long,
    val memoryPercentage: Float,
    val timestamp: Long
)

data class ProcessInfo(
    val pid: Int,
    val name: String,
    val importance: Int,
    val isRunning: Boolean,
    val timestamp: Long
)

data class EventLogEntry(
    val timestamp: Long,
    val eventType: String,
    val source: String,
    val message: String,
    val severity: String
)

interface IntrospectionListener {
    fun onStateChanged(state: ScreenState)
    fun onMemoryWarning(metrics: MemoryMetrics)
    fun onEventLogged(entry: EventLogEntry)
}

class RuntimeIntrospectionModule private constructor(private val context: Context) :
    LifecycleObserver {

    private val lock = ReentrantReadWriteLock()
    private val handler = Handler(Looper.getMainLooper())

    private var currentScreenState: ScreenState? = null
    private val resourceCache = mutableMapOf<String, ResourceInfo>()
    private val eventLog = CopyOnWriteArrayList<EventLogEntry>()
    private val listeners = CopyOnWriteArrayList<IntrospectionListener>()
    private val uiHierarchyCache = mutableMapOf<String, UIHierarchyNode>()

    private val maxLogEntries = 1000
    private var lastMemoryCheck = 0L
    private var memoryCheckInterval = 5000L

    init {
        logEvent("INIT", "RuntimeIntrospectionModule", "Initialization started", "INFO")
    }

    fun registerListener(listener: IntrospectionListener) = lock.write {
        if (!listeners.contains(listener)) {
            listeners.add(listener)
            logEvent("LISTENER", "RuntimeIntrospectionModule", "Listener registered", "DEBUG")
        }
    }

    fun unregisterListener(listener: IntrospectionListener) = lock.write {
        listeners.remove(listener)
        logEvent("LISTENER", "RuntimeIntrospectionModule", "Listener unregistered", "DEBUG")
    }

    @OnLifecycleEvent(Lifecycle.Event.ON_RESUME)
    fun onScreenActive() = lock.write {
        val screenState = ScreenState(
            activeScreen = getCurrentActivityName(),
            isVisible = true,
            lifecycle = "RESUMED",
            timestamp = System.currentTimeMillis()
        )
        currentScreenState = screenState
        logEvent("SCREEN", getCurrentActivityName(), "Screen resumed", "INFO")
        listeners.forEach { it.onStateChanged(screenState) }
    }

    @OnLifecycleEvent(Lifecycle.Event.ON_PAUSE)
    fun onScreenInactive() = lock.write {
        val screenState = ScreenState(
            activeScreen = getCurrentActivityName(),
            isVisible = false,
            lifecycle = "PAUSED",
            timestamp = System.currentTimeMillis()
        )
        currentScreenState = screenState
        logEvent("SCREEN", getCurrentActivityName(), "Screen paused", "INFO")
        listeners.forEach { it.onStateChanged(screenState) }
    }

    fun getActiveScreen(): ScreenState? = lock.read { currentScreenState }

    fun registerResource(name: String, type: String, size: Long) = lock.write {
        val resource = ResourceInfo(
            name = name,
            type = type,
            size = size,
            loaded = true,
            timestamp = System.currentTimeMillis()
        )
        resourceCache[name] = resource
        logEvent("RESOURCE", type, "Resource loaded: $name (${formatBytes(size)})", "DEBUG")
    }

    fun unregisterResource(name: String) = lock.write {
        resourceCache.remove(name)
        logEvent("RESOURCE", "UNLOAD", "Resource unloaded: $name", "DEBUG")
    }

    fun getLoadedResources(): List<ResourceInfo> = lock.read {
        resourceCache.values.toList()
    }

    fun getResourceInfo(name: String): ResourceInfo? = lock.read {
        resourceCache[name]
    }

    fun getTotalResourceSize(): Long = lock.read {
        resourceCache.values.sumOf { it.size }
    }

    fun updateUIHierarchy(screenName: String, root: UIHierarchyNode) = lock.write {
        uiHierarchyCache[screenName] = root
        logEvent("UI_HIERARCHY", screenName, "Hierarchy updated", "DEBUG")
    }

    fun getUIHierarchy(screenName: String): UIHierarchyNode? = lock.read {
        uiHierarchyCache[screenName]
    }

    fun getMemoryMetrics(): MemoryMetrics {
        val runtime = Runtime.getRuntime()
        val currentTime = System.currentTimeMillis()

        if (currentTime - lastMemoryCheck >= memoryCheckInterval) {
            lastMemoryCheck = currentTime
        }

        val totalMemory = runtime.totalMemory()
        val freeMemory = runtime.freeMemory()
        val maxMemory = runtime.maxMemory()
        val usedMemory = totalMemory - freeMemory
        val memoryPercentage = (usedMemory.toFloat() / maxMemory.toFloat()) * 100f

        val nativeHeap = Debug.getNativeHeap().sumOf { it.size }
        val javaHeap = Debug.getGlobalGcInvocationCount().toLong()

        val metrics = MemoryMetrics(
            nativeHeap = nativeHeap,
            javaHeap = usedMemory,
            totalMemory = totalMemory,
            freeMemory = freeMemory,
            maxMemory = maxMemory,
            memoryPercentage = memoryPercentage,
            timestamp = currentTime
        )

        if (memoryPercentage > 85f) {
            logEvent("MEMORY", "SYSTEM", "Memory warning: ${memoryPercentage.toInt()}%", "WARN")
            listeners.forEach { it.onMemoryWarning(metrics) }
        }

        return metrics
    }

    fun getActiveProcesses(): List<ProcessInfo> = lock.read {
        val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
        val runningProcesses = activityManager.runningAppProcesses ?: emptyList()

        runningProcesses.map { process ->
            ProcessInfo(
                pid = process.pid,
                name = process.processName,
                importance = process.importance,
                isRunning = true,
                timestamp = System.currentTimeMillis()
            )
        }
    }

    fun getCurrentProcessInfo(): ProcessInfo? = lock.read {
        val pid = Process.myPid()
        val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
        val runningProcesses = activityManager.runningAppProcesses ?: emptyList()

        runningProcesses.find { it.pid == pid }?.let { process ->
            ProcessInfo(
                pid = process.pid,
                name = process.processName,
                importance = process.importance,
                isRunning = true,
                timestamp = System.currentTimeMillis()
            )
        }
    }

    fun logEvent(eventType: String, source: String, message: String, severity: String) {
        lock.write {
            val entry = EventLogEntry(
                timestamp = System.currentTimeMillis(),
                eventType = eventType,
                source = source,
                message = message,
                severity = severity
            )

            eventLog.add(entry)

            if (eventLog.size > maxLogEntries) {
                eventLog.removeAt(0)
            }

            listeners.forEach { it.onEventLogged(entry) }
        }

        Log.d("JARVIS_INTROSPECTION", "[$eventType:$source] $message")
    }

    fun getEventLog(limit: Int = 100, severity: String? = null): List<EventLogEntry> =
        lock.read {
            eventLog.asReversed()
                .let { if (severity != null) it.filter { e -> e.severity == severity } else it }
                .take(limit)
        }

    fun getEventLogSince(timestamp: Long): List<EventLogEntry> = lock.read {
        eventLog.filter { it.timestamp >= timestamp }
    }

    fun clearEventLog() = lock.write {
        eventLog.clear()
        logEvent("LOG", "SYSTEM", "Event log cleared", "INFO")
    }

    fun getIntrospectionReport(): String = lock.read {
        val sb = StringBuilder()
        val df = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault())

        sb.append("=== JARVIS Runtime Introspection Report ===\n")
        sb.append("Timestamp: ${df.format(Date())}\n\n")

        sb.append("--- Active Screen ---\n")
        currentScreenState?.let {
            sb.append("Screen: ${it.activeScreen}\n")
            sb.append("Visible: ${it.isVisible}\n")
            sb.append("Lifecycle: ${it.lifecycle}\n")
        } ?: sb.append("No active screen\n")

        sb.append("\n--- Loaded Resources ---\n")
        if (resourceCache.isEmpty()) {
            sb.append("No resources loaded\n")
        } else {
            resourceCache.forEach { (name, info) ->
                sb.append("$name: ${info.type} (${formatBytes(info.size)})\n")
            }
            sb.append("Total: ${formatBytes(getTotalResourceSize())}\n")
        }

        sb.append("\n--- Memory Metrics ---\n")
        val memory = getMemoryMetrics()
        sb.append("Java Heap: ${formatBytes(memory.javaHeap)}\n")
        sb.append("Native Heap: ${formatBytes(memory.nativeHeap)}\n")
        sb.append("Memory Usage: ${memory.memoryPercentage.toInt()}%\n")

        sb.append("\n--- Active Processes ---\n")
        getActiveProcesses().forEach {
            sb.append("${it.name} (PID: ${it.pid})\n")
        }

        sb.append("\n--- Recent Events ---\n")
        getEventLog(20).forEach {
            sb.append("[${it.eventType}:${it.severity}] ${df.format(Date(it.timestamp))} - ${it.message}\n")
        }

        sb.toString()
    }

    private fun getCurrentActivityName(): String {
        val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
        return try {
            val tasks = activityManager.appTasks
            if (tasks.isNotEmpty()) {
                tasks[0].taskInfo.topActivity?.shortClassName ?: "Unknown"
            } else {
                "Unknown"
            }
        } catch (e: Exception) {
            "Unknown"
        }
    }

    private fun formatBytes(bytes: Long): String {
        return when {
            bytes >= 1_000_000_000 -> "${bytes / 1_000_000_000}GB"
            bytes >= 1_000_000 -> "${bytes / 1_000_000}MB"
            bytes >= 1_000 -> "${bytes / 1_000}KB"
            else -> "${bytes}B"
        }
    }

    companion object {
        @Volatile
        private var instance: RuntimeIntrospectionModule? = null

        fun getInstance(context: Context): RuntimeIntrospectionModule {
            return instance ?: synchronized(this) {
                instance ?: RuntimeIntrospectionModule(context.applicationContext).also {
                    instance = it
                }
            }
        }
    }
}