<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Make the system speech-recognition service visible (Android 11+ package visibility), so the
         on-device Google recognizer can be used for spoken commands after the wake word. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The Spotify App Remote SDK must be able to see AND bind to the installed Spotify app. On
             Android 11+ (this device is API 37) package visibility is filtered by default, so without
             this the in-app player's SpotifyAppRemote.connect() can never find/bind Spotify and just
             spins on "Connecting…". Declaring the package restores that visibility. -->
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Networking for all the free public data sources. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Trusted Network Mode: read Wi-Fi state + (Device-Owner only) toggle the radio when the device
         leaves the home network and cellular is carrying it. CHANGE_WIFI_STATE is a no-op for ordinary
         apps on Android 10+; it only takes effect once Pulse is provisioned as a Device Owner. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Keeps a stream alive with the screen off.
         ⚠️ Load-bearing rather than defensive: ExoPlayer's `setWakeMode(C.WAKE_MODE_NETWORK)` acquires
         a partial wake lock AND a Wi-Fi lock, and without this permission that call does nothing at
         all — silently. The radio's foreground service keeps the PROCESS alive but holds no lock, so
         doze could stall the socket and the drop then landed in a retry window measured in seconds.
         This is the second, independent cause of "it will not stay tuned". -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Push notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen takeovers that show over the lock screen (e.g. the BREAKING NEWS interrupt). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps": grants the background-activity-launch exemption the REAL breaking-news
         takeover uses to open its full-screen page mid-use with no tap (TakeoverLauncher). User-granted
         via the system screen (Settings → Notifications offers the shortcut); without it the takeover
         falls back to the full-screen-intent notification above. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- On-device security auditor (read-only, local-only): enumerate installed apps + their permissions
         (QUERY_ALL_PACKAGES) and read per-app data usage (PACKAGE_USAGE_STATS, granted by the user via
         Settings → Usage access). Both are sideload-appropriate; the auditor never transmits findings. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Background refresh that survives reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Let J.A.R.V.I.S. set alarms/timers in the clock app (normal permission). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Self-update: install a newer APK the app downloaded (the user still confirms in the system
         installer, and must grant "install unknown apps" once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Lets an update complete with no confirmation, but ONLY for the installer of record of the
      package being updated. This app is not that yet — every install so far came through the system
      installer UI — so the permission arms itself one update after the first session ApkInstaller
      commits. It is the fallback route; the primary is device-owner status, which needs nothing here.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Active-Matrix: keep J.A.R.V.I.S. resident as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only used while the opt-in "J.A.R.V.I.S." wake word is enabled. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- PIP-BOY radio: keep streaming while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Optional voice: on-device speech-to-text (tap-to-talk) and the J.A.R.V.I.S. wake word.
         All audio is processed locally by Vosk and never recorded or transmitted (opt-in). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Sensorium: ambient environment sensing. Camera frames and mic sips are classified fully
         on-device (MediaPipe) into text labels and immediately discarded — nothing raw is ever
         persisted or transmitted. Camera is runtime-gated; the FGS camera/microphone types can only
         be armed from a foreground app-open (Android 14+ while-in-use law), after which they persist
         for the service's life. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Optional vitals: pair a Bluetooth LE heart-rate strap (opt-in, runtime-gated).
         neverForLocation: we never use BLE scans to derive location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Optional, only used if the user enables device-location weather. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Optional: read calendar events with a location to show them as NAV objectives (opt-in). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Survival tools (haptics) and optional one-tap SOS SMS. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
      Steps, for HEALTH ▸ HABITS. ⚠️ TelemetryController has read TYPE_STEP_COUNTER since it was
      written, but WITHOUT this permission the sensor delivers no events at all on API 29+ — so the
      listener existed, the field existed, and neither could ever hold a number. Runtime-requested
      from the HABITS tab; refused, the tab says the count is unavailable rather than showing zero.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- This app is built exclusively for a single flagship device. Declaring
         it touch-only with a high-density large screen keeps the Play-style
         feature contract explicit even though distribution is sideload-only. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".PulseApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Pulse"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pulse.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Catches the Spotify OAuth (PKCE) redirect; exchanges the code then returns to the app.
             The owner must register this exact redirect URI in the Spotify developer dashboard. -->
        <activity
            android:name=".feature.spotify.SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.mascwa.pulse" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- BREAKING NEWS: a floating, partly transparent card carrying ONE story, over whatever you are
             doing. Non-focusable and non-touch-modal, so the app behind stays fully usable and touches
             outside the card go straight through to it — you can work around it or drag it aside rather
             than having to deal with it. Replaces a full-screen takeover that used FLAG_ACTIVITY_CLEAR_TASK
             and therefore destroyed your place in the app. -->
        <service
            android:name=".feature.breaking.BreakingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="breaking_news_overlay" />
        </service>

        <!-- The full coverage page — now a destination you CHOOSE from the card above (or from the
             full-screen-intent notification when "display over other apps" isn't granted), never something
             forced over what you were reading. -->
        <activity
            android:name=".feature.breaking.BreakingNewsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Pulse" />

        <!-- OFFICIAL EMERGENCY ALERT — a full-screen condition-red takeover with a full-volume alarm on
             the alarm stream, raised from a government CAP feed (never from a news headline). Back is
             deliberately disabled; the acknowledge button is the only way out. Shows over the lock screen
             and keeps the screen on. -->
        <activity
            android:name=".feature.redalert.RedAlertActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Pulse" />

        <!-- The watch that makes the alert above arrive in time: a dedicated always-on poll of the same
             CAP feed that drives Wireless Emergency Alerts, roughly every minute. It cannot intercept or
             preempt WEA itself (that reaches the modem via CellBroadcast and no ordinary app can see it) —
             it is an independent second path to the same source. -->
        <service
            android:name=".notifications.EmergencyWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="official_emergency_alert_watch" />
        </service>

        <!-- Re-arm the periodic refresh worker after a reboot. -->
        <!--
          The install session's own result. Not exported: the PendingIntent that reaches it is
          package-scoped, and an exported receiver here would let any app fake an install outcome.
        -->
        <receiver
            android:name=".data.update.ApkInstaller$ResultReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.mascwa.pulse.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Trusted Network Mode: device-admin component so Pulse can be provisioned as a Device Owner
             (one-time adb), which unlocks the Wi-Fi-toggle privilege. Requests no intrusive policies. -->
        <receiver
            android:name=".security.PulseDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          The one widget. It reads how much room it has been given and draws a different layout for
          each size rather than the same rows stretched, so there is nothing left for a picker to
          ask about — which is why the other two receivers and the configure activity are gone.

          ⚠️ The class name and the `widget_lock` layout id are IDENTITY, not copy. Renaming either
          orphans every instance already placed on a home screen, which is why they survived a
          consolidation that changed everything else about this widget.
        -->
        <receiver
            android:name=".widget.LockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_lock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_widget_info" />
        </receiver>

        <!-- Active-Matrix resident assistant. specialUse on API 34+, dataSync below;
             the service picks the matching type at runtime. -->
        <service
            android:name=".jarvis.matrix.ActiveMatrixService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_device_assistant_context" />
        </service>

        <!-- Optional BLE heart-rate vitals monitor (opt-in). -->
        <service
            android:name=".jarvis.vitals.VitalsTrackingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Sensorium ambient environment sensing. The UPGRADEABLE service: background starts use
             specialUse only (dataSync is the API 31-33 fallback); a foreground app-open re-invokes
             startForeground adding microphone|camera, which then persist for the service's life.
             Classify-then-discard — labels only, nothing raw persisted or transmitted. -->
        <service
            android:name=".data.sensing.SensoriumService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ambient_environment_sensing" />
        </service>

        <!--
            The acoustic interrogator (opt-in, DEFAULT OFF — the only sensing feature that is).
            Continuous speech capture, transcribed offline and screened for reasoning mistakes; the
            transcript is encrypted at rest, capped, and never leaves the device.

            Started only from a visible activity: the microphone foreground-service type cannot be
            armed from a background start on Android 14+, so a background caller would produce a
            service that holds the microphone floor and records nothing. exported="false" — nothing
            outside the app may start something that opens the microphone.
        -->
        <service
            android:name=".data.interrogator.AcousticInterrogatorService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="acoustic_interrogation" />
        </service>

        <!--
            LAN remote link (opt-in, default off). exported="false" is deliberate and load-bearing: the
            service must never be startable by another app on the device. Its inbound surface is the TCP
            socket it opens, which is guarded by pairing + signatures + a private-address check, not by
            Android's component permissions.
        -->
        <service
            android:name=".remote.RemoteLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- PIP-BOY radio playback — keeps the stream alive when the app is backgrounded. -->
        <service
            android:name=".feature.tacnet.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Viewscreen audio-only playback — keeps an on-demand audio session alive backgrounded. -->
        <service
            android:name=".feature.theater.OnDemandService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- We schedule our own WorkManager instance from PulseApplication via
             the Configuration.Provider, so disable the default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Shares the downloaded update APK with the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
