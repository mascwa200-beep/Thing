<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Make the system speech-recognition service visible (Android 11+ package visibility), so the
         on-device Google recognizer can be used for spoken commands after the wake word. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The Spotify App Remote SDK must be able to see AND bind to the installed Spotify app. On
             Android 11+ (this device is API 37) package visibility is filtered by default, so without
             this the in-app player's SpotifyAppRemote.connect() can never find/bind Spotify and just
             spins on "Connecting…". Declaring the package restores that visibility. -->
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Networking for all the free public data sources. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Trusted Network Mode: read Wi-Fi state + (Device-Owner only) toggle the radio when the device
         leaves the home network and cellular is carrying it. CHANGE_WIFI_STATE is a no-op for ordinary
         apps on Android 10+; it only takes effect once Pulse is provisioned as a Device Owner. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Push notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen self-care check-in that shows over the lock screen (opt-in, default off). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- On-device security auditor (read-only, local-only): enumerate installed apps + their permissions
         (QUERY_ALL_PACKAGES) and read per-app data usage (PACKAGE_USAGE_STATS, granted by the user via
         Settings → Usage access). Both are sideload-appropriate; the auditor never transmits findings. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Background refresh that survives reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Let J.A.R.V.I.S. set alarms/timers in the clock app (normal permission). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Self-update: install a newer APK the app downloaded (the user still confirms in the system
         installer, and must grant "install unknown apps" once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Active-Matrix: keep J.A.R.V.I.S. resident as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only used while the opt-in "J.A.R.V.I.S." wake word is enabled. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- PIP-BOY radio: keep streaming while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Optional voice: on-device speech-to-text (tap-to-talk) and the J.A.R.V.I.S. wake word.
         All audio is processed locally by Vosk and never recorded or transmitted (opt-in). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Ambient SEEING for the life-sim: short camera frames are classified on-device (object/scene labels)
         and immediately discarded — no image is ever stored or transmitted (opt-in, runtime-gated). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Real-world activity for the life-sim: today's step count (TYPE_STEP_COUNTER) buffs the character.
         Aggregate + on-device only — the raw count never leaves the device (opt-in, runtime-gated on API 29+). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- Optional vitals: pair a Bluetooth LE heart-rate strap (opt-in, runtime-gated).
         neverForLocation: we never use BLE scans to derive location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Optional, only used if the user enables device-location weather. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Optional: read calendar events with a location to show them as NAV objectives (opt-in). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Survival tools (haptics) and optional one-tap SOS SMS. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- This app is built exclusively for a single flagship device. Declaring
         it touch-only with a high-density large screen keeps the Play-style
         feature contract explicit even though distribution is sideload-only. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".PulseApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Pulse"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pulse.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Catches the Spotify OAuth (PKCE) redirect; exchanges the code then returns to the app.
             The owner must register this exact redirect URI in the Spotify developer dashboard. -->
        <activity
            android:name=".feature.spotify.SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dev.mascwa.pulse" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- The aggressive full-screen self-care check-in — shows over the lock screen and can't be
             dismissed until answered (opt-in). Launched via a full-screen intent from the worker. -->
        <activity
            android:name=".feature.checkin.CheckinActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Pulse" />

        <!-- Re-arm the periodic refresh worker after a reboot. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Trusted Network Mode: device-admin component so Pulse can be provisioned as a Device Owner
             (one-time adb), which unlocks the Wi-Fi-toggle privilege. Requests no intrusive policies. -->
        <receiver
            android:name=".security.PulseDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Glanceable home-screen widget: active objective + weather; taps to the J.A.R.V.I.S. console. -->
        <receiver
            android:name=".widget.PulseWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulse_widget_info" />
        </receiver>

        <!-- Compact glanceable widget, lock-screen-eligible (widgetCategory keyguard|home_screen):
             active objective + weather + top market mover. -->
        <receiver
            android:name=".widget.LockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_lock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_widget_info" />
        </receiver>

        <!-- Live data-feed widget: auto-cycles markets · fuel · economy/inflation · news. Backed by a
             RemoteViewsService collection; the AdapterViewFlipper auto-advances. -->
        <receiver
            android:name=".widget.FeedWidgetProvider"
            android:exported="true"
            android:label="@string/widget_feed_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/feed_widget_info" />
        </receiver>
        <service
            android:name=".widget.FeedRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Four J.A.R.V.I.S. widgets (STATUS / OBJECTIVE / FINDING / BRIEF). Each opens a config screen on
             placement to choose HIGH-contrast or TRANSPARENT (text-only) mode. They share one layout +
             provider info; the renderer derives the content from the receiver class. -->
        <receiver
            android:name=".widget.JarvisStatusWidget"
            android:exported="true"
            android:label="@string/widget_jarvis_status">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.JarvisObjectiveWidget"
            android:exported="true"
            android:label="@string/widget_jarvis_objective">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.JarvisFindingWidget"
            android:exported="true"
            android:label="@string/widget_jarvis_finding">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.JarvisBriefWidget"
            android:exported="true"
            android:label="@string/widget_jarvis_brief">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_info" />
        </receiver>

        <!-- Per-instance look picker for the J.A.R.V.I.S. widgets (high-contrast / transparent). -->
        <activity
            android:name=".widget.JarvisWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Pulse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Active-Matrix resident assistant. specialUse on API 34+, dataSync below;
             the service picks the matching type at runtime. -->
        <service
            android:name=".jarvis.matrix.ActiveMatrixService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_device_assistant_context" />
        </service>

        <!-- Optional BLE heart-rate vitals monitor (opt-in). -->
        <service
            android:name=".jarvis.vitals.VitalsTrackingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- PIP-BOY radio playback — keeps the stream alive when the app is backgrounded. -->
        <service
            android:name=".feature.tacnet.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- J.A.R.V.I.S. arc-reactor live wallpaper. Reads only on-device cached Pulse data; drawn
             procedurally (no bitmaps). Set it from Settings → Appearance → J.A.R.V.I.S. live wallpaper. -->
        <service
            android:name=".wallpaper.JarvisWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_jarvis_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/jarvis_wallpaper" />
        </service>

        <!-- We schedule our own WorkManager instance from PulseApplication via
             the Configuration.Provider, so disable the default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Shares the downloaded update APK with the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
