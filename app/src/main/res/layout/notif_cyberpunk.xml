<?xml version="1.0" encoding="utf-8"?>
<!-- Cyberpunk 2077-style notification content (collapsed). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/cp_bg"
    android:padding="10dp">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="@color/cp_yellow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_var"
            android:textColor="@color/cp_yellow"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="// ALERT" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/chakra_petch_bold"
            android:textColor="@color/cp_ink"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Title" />

        <TextView
            android:id="@+id/notif_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/jetbrains_mono_var"
            android:textColor="@color/cp_dim"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Body" />
    </LinearLayout>
</LinearLayout>
