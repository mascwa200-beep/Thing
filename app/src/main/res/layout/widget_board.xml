                style="@style/WidgetLine.Board.Header.Clock" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_board_subhead"
            style="@style/WidgetLine.Board.Dim" />

        <!--
          What you are in the middle of, or what comes next — "NOW · Inspections · until 7:55" /
          "NEXT 8:00 AM · Training · Gym". Directly under the clock because it is the calendar's
          answer to the question the clock asks, and drawn on BOTH tall sizes: the compact board has
          no room for the agenda list, but it always has room for this one line. Tapping it opens
          the event in the calendar app.
