<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/dial_slot_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_slot_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_slot_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/dial_slot_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_center" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:scaleType="fitCenter" android:src="@drawable/ic_dial_reactor" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_slot_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/dial_slot_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_slot_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
        <ImageView android:id="@+id/dial_slot_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="@string/widget_dial_label" />
    </LinearLayout>
</LinearLayout>
