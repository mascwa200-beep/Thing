<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Given an id so the provider can tint it with the ship's condition; it was an anonymous view
         nothing could reach. -->
    <TextView
        android:id="@+id/widget_feed_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LCARS · LIVE FEED"
        android:textColor="@color/nw_accent"
        android:textStyle="bold"
        android:textSize="11sp"
        android:letterSpacing="0.12" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <AdapterViewFlipper
            android:id="@+id/widget_feed_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="6000"
            android:loopViews="true"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out" />

        <TextView
            android:id="@+id/widget_feed_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="Open LCARS to load the live feed"
            android:textColor="@color/nw_faint"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
