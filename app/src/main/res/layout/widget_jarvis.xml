<?xml version="1.0" encoding="utf-8"?>
<!-- Shared layout for all four J.A.R.V.I.S. widgets. The background is set at runtime by the renderer
     (panel for HIGH contrast, none for TRANSPARENT), so the same layout serves both modes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S."
        android:textColor="#2DE2E6"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/widget_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#E6EFFA"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#A9B8CE"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tap to open"
        android:textColor="#5E708C"
        android:textSize="10sp" />
</LinearLayout>
