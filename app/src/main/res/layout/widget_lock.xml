<?xml version="1.0" encoding="utf-8"?>
<!--
  The one widget.

  ⚠️ **The rows are deliberately GENERIC — `widget_row_0`…`widget_row_15`, not `lock_weather`,
  `lock_market` and so on.** The previous layout named every row after the feed that filled it,
  which meant the widget could only ever show that exact list in that exact order at every size. A
  row's meaning now comes from what the provider puts in it: text, colour, size and tap target are
  all set at render time, so the same resource serves a two-cell widget showing four lines and a
  full-height one showing sixteen. One layout, four `RemoteViews` built from it, no duplication to
  drift.

  ⚠️ The id `widget_lock` and the root id `widget_lock_root` are IDENTITY. Renaming either orphans
  every instance already placed on a home screen, so they survive a rewrite that changed everything
  else about this file.

  No background plate — the widget sits on the user's own wallpaper — so every row carries the drop
  shadow defined in `WidgetLine`, which is the only thing guaranteeing contrast over a light one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView android:id="@+id/widget_row_0" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_1" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_2" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_3" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_4" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_5" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_6" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_7" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_8" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_9" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_10" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_11" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_12" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_13" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_14" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_15" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_16" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_17" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_18" style="@style/WidgetLine.Row" />
    <TextView android:id="@+id/widget_row_19" style="@style/WidgetLine.Row" />
</LinearLayout>
