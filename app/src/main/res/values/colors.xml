<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shell colours (Compose drives the live palette at runtime). Matches tosPalette.void exactly
         (pure black) so the earliest-visible frame — window/splash background, launcher icon — is
         consistent with the in-app console palette. -->
    <color name="nw_void">#000000</color>
    <!-- The app's command gold. Was the LCARS orange #FF9900, and before that a stray cyberpunk
         cyan; each time it has been corrected rather than deleted so a future reference picks up the
         right colour instead of resurrecting a retired one. -->
    <color name="nw_accent">#FFB000</color>
    <color name="ic_launcher_background">#000000</color>
    <!-- Notification alert-condition colours — the red-alert/yellow-alert convention.
         lcars_condition_routine tracks tosPalette.accent exactly (the app's real command gold); the
         other two stay purpose-built for glanceable tray legibility at small size rather than
         tracking the palette, which is why they did not move with the accent.
         These are duplicated by hand because a notification is inflated from XML and cannot read the
         Compose palette — so when the accent moves, it must be moved here in the same commit. -->
    <color name="lcars_condition_routine">#FFB000</color>
    <color name="lcars_condition_yellow">#FFCC42</color>
    <color name="lcars_condition_red">#FF3B30</color>
    <!-- The one-notification board's per-row tag colours — real in-app TosPalette tokens, so the
         notification and the app speak the same dialect. Six tags that must stay tellable apart at
         tray size, so they are spread across the hue circle rather than clustered in the warm end;
         markets deliberately avoids green and red, which carry direction elsewhere in the app. -->
    <color name="lcars_row_news">#FFB000</color>
    <color name="lcars_row_markets">#FF7A1A</color>
    <color name="lcars_row_weather">#22B8E0</color>
    <color name="lcars_row_agenda">#8A5CE0</color>
    <color name="lcars_row_advisory">#E0409A</color>
    <color name="lcars_row_lesson">#24C04A</color>
    <color name="lcars_row_health">#3FBFA0</color>
    <!-- Home-screen widget palette — real TosPalette tokens, under the same rule as the
         notification colours above and for exactly the same reason: a widget is RemoteViews
         inflated from XML and cannot read the Compose palette, so when the palette moves it must
         be moved here in the same commit.

         ⚠️ These exist because the widgets were the LAST surviving consumers of the retired
         NIGHTWIRE palette — sixteen hardcoded hex values across seven variants of what should be
         five tokens, including two different drifted accents and a `positive`/`negative` pair that
         drew market direction in colours the rest of the app had abandoned. `WidgetLinkageTest`
         now fails the build on any raw hex in a widget file, so this is the last copy rather than
         the fifth.

         There is no third text tier here, and that is deliberate. The widget draws with no
         background over an arbitrary wallpaper, so its dimmest line takes nw_muted: text that has
         to survive a light wallpaper cannot also be the darkest grey in the set. Only
         @drawable/widget_bg paints a panel, and it backs the fault card alone. -->
    <color name="nw_ink">#F4F4F6</color>
    <color name="nw_muted">#ACACB6</color>
    <color name="nw_panel">#121216</color>
    <color name="nw_line">#3C3C44</color>
    <!-- Semantic, and the reason the drift mattered: these carry market direction. -->
    <color name="nw_positive">#24C04A</color>
    <color name="nw_negative">#E02020</color>
    <!-- Red alert, from tosRedAlert. Only the accent moves: the alert palette deliberately keeps
         the greys and the ink exactly as they are, so an alert never makes a readout harder to
         read. Chosen by AlertStatus.condition, the same process-wide flag that recolours every
         screen and tints the tray. -->
    <color name="nw_alert_accent">#E01414</color>
    <!-- Not a palette colour — a legibility device. The lock widget draws no background of its own,
         so every line carries a drop shadow to survive an arbitrary wallpaper. It lives here so the
         "no raw hex in a widget file" rule can be absolute rather than carrying an exception. -->
    <color name="nw_shadow">#E6000000</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
