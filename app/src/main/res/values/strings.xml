    <string name="widget_lock_label">LCARS</string>
    <string name="widget_lock_description">What the Computer thinks you should know, in as much detail as you give it room for. Resize it — it shows more, not the same rows stretched.</string>

    <!-- The fault card. ⚠️ This is NOT the launcher's "Can't load widget": that string belongs to
         the host and no app can replace it. This is what we draw so the host never has to. -->
    <string name="widget_fault_title">LCARS · WIDGET FAULT</string>
    <string name="widget_fault_hint">Screenshot this, or open MENU ▸ Crash Console and send a report.</string>

