<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. The actual colours come from Compose
         (Material You dynamic colour) at runtime; this is the framework-level
         shell theme used before Compose attaches. -->
    <style name="Theme.Pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowBackground">@color/nw_void</item>
    </style>

    <!-- The lock-screen board: the wallpaper behind it rather than a painted background, so it reads as
         the owner's own lock screen with the board on it. Opaque window, not translucent, on purpose:
         a full-screen opaque showWhenLocked activity is what the system treats as covering the
         keyguard, the way a navigation app does. -->
    <style name="Theme.Pulse.LockBoard">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme (androidx.core.splashscreen). -->
    <style name="Theme.Pulse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nw_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pulse</item>
    </style>
</resources>
