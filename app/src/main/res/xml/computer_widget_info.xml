<?xml version="1.0" encoding="utf-8"?>
<!-- Provider info for the one Computer widget. What it shows (status / objective / finding / brief)
     and how it looks (high-contrast panel / transparent) are both chosen per instance in the
     configure activity — this used to be four separate providers that differed only in those two
     answers, two of which had drifted to the same title AND the same tap route. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_computer"
    android:previewLayout="@layout/widget_computer"
    android:configure="dev.mascwa.pulse.widget.ComputerWidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
