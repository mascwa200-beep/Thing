<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Including only datastore/ already excludes everything else (cache, model, etc.). -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
