<?xml version="1.0" encoding="utf-8"?>
<!-- Shared provider info for the four J.A.R.V.I.S. widgets. Each receiver in the manifest gives its own
     android:label; the configure activity lets the user pick HIGH-contrast vs TRANSPARENT per instance. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_jarvis"
    android:previewLayout="@layout/widget_jarvis"
    android:configure="dev.mascwa.pulse.widget.JarvisWidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
