<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ⚠️ Declared HERE rather than in each application, because this module is what opens the camera
      and a consumer that forgot the permission would fail at runtime with nothing at build time to
      say why. Both applications already declare it; the merge is idempotent.

      ⚠️ `required="false"` on the feature: a phone with no camera should still be able to install
      and use every other part of either application. The scanner asks and reports honestly.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

</manifest>
